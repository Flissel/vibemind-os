# ============================================================================
# VibeMind-OS — Environment Configuration
# ============================================================================
# Copy to .env and fill in your API keys.
# Each service reads from this file or its own .env.

# ── LLM Provider Keys ──────────────────────────────────────────────────────
# vibemind-os supports 5 LLM providers:
#   openai, anthropic, openrouter, google, ollama (local — no key needed)
# Set at least one cloud key, OR run Ollama locally for fully offline mode.
# Provider/model assignment per role lives in llm_config.yml — not here.

# OpenAI — gpt-4o, gpt-4o-mini, gpt-4o-realtime-preview (voice)
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Anthropic — Claude Sonnet/Opus/Haiku (direct, best for coding)
# https://console.anthropic.com/
ANTHROPIC_API_KEY=

# OpenRouter — gateway to 100+ models, free tier available
# https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Google — Gemini 2.0 Flash, Gemini 1.5 Pro
# https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Ollama — local LLMs, no key needed
# Install: https://ollama.com/ then `ollama serve`

# ── Service Ports ───────────────────────────────────────────────────────────
BRAIN_PORT=5000
OPENFANG_PORT=50051
BRIDGE_PORT=5100

# ── Brain (Tahlamus) ───────────────────────────────────────────────────────
# Memory system (optional — enables long-term memory)
SUPERMEMORY_API_KEY=
DEV_MODE=true
LOG_LEVEL=INFO

# ── OpenFang ────────────────────────────────────────────────────────────────
# Default provider — must be one of: openai, anthropic, openrouter, google, ollama
OPENFANG_DEFAULT_PROVIDER=ollama
OPENFANG_DEFAULT_MODEL=qwen2.5-coder:7b

# Claude Code CLI (optional — enables claude-code provider)
# Requires: npm install -g @anthropic-ai/claude-code && claude auth
# On Windows: add npm global bin to System PATH, not just Git Bash

# ── Bridge ──────────────────────────────────────────────────────────────────
BRAIN_URL=http://localhost:5000
OPENFANG_URL=http://localhost:50051

# ── Telegram (optional — for OpenFang chat) ─────────────────────────────────
TELEGRAM_BOT_TOKEN=

# ── ffmpeg (optional override) ──────────────────────────────────────────────
# Used by Video Studio Live recording + faceswap audio mux. Auto-detected
# from PATH and common Windows install locations (winget, scoop, chocolatey).
# Only set this if auto-detection fails or you want to pin a specific build.
# Install via: winget install ffmpeg   OR   scoop install ffmpeg
# Example override: FFMPEG_PATH=C:\tools\ffmpeg\bin\ffmpeg.exe
# FFMPEG_PATH=
