FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV VIBEMIND_CONFIG_DIR=/config

WORKDIR /app

# Git is only needed to install the exact vibemind-shared dependency pin.
RUN apt-get update && \
    apt-get install -y --no-install-recommends git && \
    rm -rf /var/lib/apt/lists/*

COPY requirements.legit.txt .
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements.legit.txt

COPY legitimate_worker.py ./
COPY messages.py ./

CMD ["python", "-u", "legitimate_worker.py"]
