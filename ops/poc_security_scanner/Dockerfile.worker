FROM python:3.11-slim

WORKDIR /app

ENV VIBEMIND_CONFIG_DIR=/config

COPY requirements.legit.txt .
RUN pip install --no-cache-dir -r requirements.legit.txt

COPY messages.py .
COPY tools.py .
COPY orchestrator.py .
COPY scanner.py .
COPY analyzer.py .
COPY reporter.py .
COPY worker.py .

CMD ["python", "-u", "worker.py"]
