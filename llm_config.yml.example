# =============================================================================
# VibeMind-OS — LLM routing source of truth
# =============================================================================
#
# Application services resolve a logical role with:
#   vibemind_shared.get_client(role)
#   vibemind_shared.get_model(role)
#
# For every non-exempt role the client targets OpenFang's OpenAI-compatible
# endpoint and the model names the OpenFang agent that owns execution. OpenFang
# then selects the OpenAI cloud model configured in that agent's manifest.
#
# `voice_realtime` is the only direct-provider exception represented here.
# It remains explicit so an OpenFang outage cannot silently trigger a bypass.
# =============================================================================

keys:
  openfang: ${OPENFANG_API_KEY}
  openai: ${OPENAI_API_KEY}

providers:
  openfang:
    type: openai
    base_url: ${OPENFANG_URL}/v1
    key_ref: openfang
    fail_closed: true
    max_retries: 3
    timeout_seconds: 30

  # Declared exception: the realtime transport is not an OpenFang chat agent.
  openai:
    type: openai
    base_url: https://api.openai.com/v1
    key_ref: openai

default:
  provider: openfang
  model: openfang:brain-fallback
  temperature: 0

roles:
  # Brain
  # Both the current brain_* names and legacy direct call-site names stay
  # OpenFang-routed while callers migrate; neither config can select a provider.
  fast_reasoning:          { provider: openfang, model: "openfang:brain-fallback",   temperature: 0.3 }
  planning:                { provider: openfang, model: "openfang:brain-planner",    temperature: 0.7 }
  context_tracking:        { provider: openfang, model: "openfang:brain-knowledge",  temperature: 0.5 }
  communication:           { provider: openfang, model: "openfang:brain-writer",     temperature: 0.8 }
  long_term_memory:        { provider: openfang, model: "openfang:brain-knowledge",  temperature: 0.5 }
  supermemory:             { provider: openfang, model: "openfang:brain-knowledge",  temperature: 0.5 }
  format_generation:       { provider: openfang, model: "openfang:brain-writer",     temperature: 0.2 }
  brain_fast_reasoning:    { provider: openfang, model: "openfang:brain-fallback",   temperature: 0.3 }
  brain_planning:          { provider: openfang, model: "openfang:brain-planner",    temperature: 0.7 }
  brain_context_tracking:  { provider: openfang, model: "openfang:brain-knowledge",  temperature: 0.5 }
  brain_communication:     { provider: openfang, model: "openfang:brain-writer",     temperature: 0.8 }
  brain_long_term_memory:  { provider: openfang, model: "openfang:brain-knowledge",  temperature: 0.5 }
  brain_supermemory:       { provider: openfang, model: "openfang:brain-knowledge",  temperature: 0.5 }
  brain_data_collector:    { provider: openfang, model: "openfang:brain-researcher", temperature: 0.7 }
  # Compatibility role name; execution no longer selects Anthropic directly.
  brain_data_collector_anthropic: { provider: openfang, model: "openfang:brain-researcher", temperature: 0.7 }

  # Coding Space
  coding_planner:          { provider: openfang, model: "openfang:brain-coder", temperature: 0.7 }
  coding_executor:         { provider: openfang, model: "openfang:brain-coder", temperature: 0 }
  coding_reviewer:         { provider: openfang, model: "openfang:brain-coder", temperature: 0 }
  coding_test_writer:      { provider: openfang, model: "openfang:brain-coder", temperature: 0 }
  coding_security_audit:   { provider: openfang, model: "openfang:brain-coder", temperature: 0 }
  coding_architect:        { provider: openfang, model: "openfang:brain-coder", temperature: 0.5 }

  # Voice. Realtime is an explicitly declared direct OpenAI exception.
  voice_realtime:          { provider: openai,   model: gpt-4o-realtime-preview,       temperature: 0.8 }
  voice_intent_classifier: { provider: openfang, model: "openfang:brain-orchestrator", temperature: 0 }
  voice_summarizer:        { provider: openfang, model: "openfang:brain-writer",       temperature: 0.3 }
  voice_space_agent:       { provider: openfang, model: "openfang:brain-orchestrator", temperature: 0 }

  # Security
  security_red_team:       { provider: openfang, model: "openfang:brain-security", temperature: 0.7 }
  security_blue_team:      { provider: openfang, model: "openfang:brain-security", temperature: 0 }
  security_judge:          { provider: openfang, model: "openfang:brain-security", temperature: 0 }
  security_analyzer:       { provider: openfang, model: "openfang:brain-security", temperature: 0 }

  # Communication, search, and agent pipelines
  email_personalizer:      { provider: openfang, model: "openfang:email-assistant",  temperature: 0.7 }
  email_response:          { provider: openfang, model: "openfang:email-assistant",  temperature: 0 }
  fungus_summary:          { provider: openfang, model: "openfang:brain-researcher", temperature: 0 }
  fungus_judge:            { provider: openfang, model: "openfang:brain-researcher", temperature: 0 }
  rag_classifier:          { provider: openfang, model: "openfang:brain-knowledge",  temperature: 0 }
  agent_minibook:          { provider: openfang, model: "openfang:brain-knowledge",  temperature: 0 }
  agent_pitch_deck:        { provider: openfang, model: "openfang:writer",           temperature: 0.7 }
  agent_pc_cleaner:        { provider: openfang, model: "openfang:brain-desktop",    temperature: 0 }

  # Legacy role names remain stable, but no longer imply a local provider.
  local_default:           { provider: openfang, model: "openfang:assistant", temperature: 0 }
  local_chat:              { provider: openfang, model: "openfang:assistant", temperature: 0.7 }
  local_fast:              { provider: openfang, model: "openfang:assistant", temperature: 0 }

  # Canonical Space chat-agent routes from config/space_agent_registry.yml.
  space_bubbles:           { provider: openfang, model: "openfang:brain-bubbles",      temperature: 0.2 }
  space_ideas:             { provider: openfang, model: "openfang:brain-ideas",        temperature: 0.2 }
  space_coding:            { provider: openfang, model: "openfang:brain-coder",        temperature: 0.2 }
  space_desktop:           { provider: openfang, model: "openfang:brain-desktop",      temperature: 0.2 }
  space_research:          { provider: openfang, model: "openfang:brain-researcher",   temperature: 0.2 }
  space_rowboat:           { provider: openfang, model: "openfang:rowboat-chat",       temperature: 0.2 }
  space_minibook:          { provider: openfang, model: "openfang:brain-knowledge",    temperature: 0.2 }
  space_schedule:          { provider: openfang, model: "openfang:brain-scheduler",    temperature: 0.2 }
  space_n8n:               { provider: openfang, model: "openfang:brain-n8n",          temperature: 0.2 }
  # Reserved chat identity only while AgentFarm remains disabled in the registry.
  space_agentfarm:         { provider: openfang, model: "openfang:brain-agentfarm",    temperature: 0.2 }
  space_video:             { provider: openfang, model: "openfang:brain-video",        temperature: 0.2 }
  space_flowzen:           { provider: openfang, model: "openfang:brain-wellness",     temperature: 0.2 }
  space_mirofish:          { provider: openfang, model: "openfang:brain-forecaster",   temperature: 0.2 }

# Directory overrides are intentionally disabled. A role always resolves to the
# same OpenFang agent regardless of the caller's filesystem location.
overrides: {}

# =============================================================================
# Embeddings — bounded Fungus gateway contract plus transitional inventory
# =============================================================================
# fungus_search is the sole role covered by the OpenFang embedding contract.
# The remaining entries retain current behavior until separate bounded migrations;
# they are not evidence that embedding consolidation or fail-closed behavior is
# complete for those roles.
embeddings:
  default:
    driver: sentence_transformers
    model: all-MiniLM-L6-v2
    dim: 384

  fungus_search:
    driver: openai
    provider: openfang
    model: text-embedding-3-large
    dim: 3072

  openai_large:
    driver: openai
    provider: openai
    model: text-embedding-3-large
    dim: 3072

  openai_small:
    driver: openai
    provider: openai
    model: text-embedding-3-small
    dim: 1536

  ollama_local:
    driver: ollama
    provider: ollama
    model: nomic-embed-text
    dim: 768

  brain_clustering:
    driver: sentence_transformers
    model: all-MiniLM-L6-v2
    dim: 384

  embeddinggemma:
    driver: sentence_transformers
    model: google/embeddinggemma-300m
    dim: 768

  code_search:
    driver: sentence_transformers
    model: all-MiniLM-L6-v2
    dim: 384
