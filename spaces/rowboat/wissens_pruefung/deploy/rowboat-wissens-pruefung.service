[Unit]
Description=Rowboat-Wissens-Pruefung: lose Notizen und tote Verbindungen als Dashboard-Notiz
Documentation=file:///home/debian/marketing-os/spaces/rowboat/wissens_pruefung/README.md
After=rowboat-geschaeftsdaten.service

[Service]
Type=oneshot
User=debian
Group=debian
WorkingDirectory=/home/debian
ExecStart=/usr/bin/python3 /home/debian/marketing-os/spaces/rowboat/wissens_pruefung/pruefung.py
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=15min
NoNewPrivileges=yes
PrivateTmp=yes
UMask=0022
