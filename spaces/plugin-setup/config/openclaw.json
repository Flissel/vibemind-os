{
  "gateway": {
    "mode": "local",
    "port": 18896,
    "bind": "loopback",
    "auth": {
      "mode": "token"
    }
  },
  "models": {
    "providers": {
      "shim": {
        "baseUrl": "http://host.docker.internal:8117/v1",
        "api": "openai-completions",
        "apiKey": "shim-prueft-keinen-schluessel",
        "models": [
          {
            "id": "claude-code-sonnet",
            "name": "claude-code-sonnet"
          },
          {
            "id": "claude-code-haiku",
            "name": "claude-code-haiku"
          }
        ]
      }
    }
  },
  "agents": {
    "defaults": {
      "model": {
        "primary": "shim/claude-code-sonnet"
      },
      "workspace": "/home/node/.openclaw/workspace"
    }
  },
  "browser": {
    "enabled": false,
    "defaultProfile": "openclaw"
  },
  "plugins": {
    "entries": {
      "browser": {
        "enabled": false
      }
    }
  },
  "mcp": {
    "servers": {
      "plugin-setup": {
        "url": "http://host.docker.internal:8131/mcp",
        "transport": "streamable-http",
        "connectionTimeoutMs": 30000,
        "requestTimeoutMs": 60000
      }
    }
  },
  "tools": {
    "deny": ["group:runtime", "group:fs", "group:web", "group:ui"],
    "web": {
      "search": {
        "enabled": false
      },
      "fetch": {
        "enabled": false
      }
    }
  }
}
