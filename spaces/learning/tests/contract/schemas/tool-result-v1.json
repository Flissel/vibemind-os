{
  "$defs": {
    "AggregateRefV1": {
      "additionalProperties": false,
      "properties": {
        "aggregate_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Aggregate Id",
          "type": "string"
        },
        "aggregate_type": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Aggregate Type",
          "type": "string"
        },
        "revision": {
          "minimum": 0,
          "title": "Revision",
          "type": "integer"
        }
      },
      "required": [
        "aggregate_type",
        "aggregate_id",
        "revision"
      ],
      "title": "AggregateRefV1",
      "type": "object"
    },
    "EvidenceRefV1": {
      "additionalProperties": false,
      "properties": {
        "evidence_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Evidence Id",
          "type": "string"
        },
        "evidence_type": {
          "enum": [
            "application_readback",
            "job_readback",
            "artifact_readback",
            "structural_status"
          ],
          "title": "Evidence Type",
          "type": "string"
        },
        "owner": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Owner",
          "type": "string"
        }
      },
      "required": [
        "owner",
        "evidence_id",
        "evidence_type"
      ],
      "title": "EvidenceRefV1",
      "type": "object"
    },
    "FocusAnswerIntentV1": {
      "additionalProperties": false,
      "properties": {
        "aggregate_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Aggregate Id",
          "type": "string"
        },
        "aggregate_revision": {
          "minimum": 0,
          "title": "Aggregate Revision",
          "type": "integer"
        },
        "field_id": {
          "default": "answer",
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Field Id",
          "type": "string"
        },
        "kind": {
          "const": "focus_answer",
          "default": "focus_answer",
          "title": "Kind",
          "type": "string"
        },
        "version": {
          "const": "1",
          "default": "1",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "aggregate_id",
        "aggregate_revision"
      ],
      "title": "FocusAnswerIntentV1",
      "type": "object"
    },
    "JsonValue": {},
    "NavigateIntentV1": {
      "additionalProperties": false,
      "properties": {
        "aggregate_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Aggregate Id",
          "type": "string"
        },
        "aggregate_revision": {
          "minimum": 0,
          "title": "Aggregate Revision",
          "type": "integer"
        },
        "kind": {
          "const": "navigate",
          "default": "navigate",
          "title": "Kind",
          "type": "string"
        },
        "route": {
          "maxLength": 512,
          "pattern": "^/learning(?:/.*)?$",
          "title": "Route",
          "type": "string"
        },
        "version": {
          "const": "1",
          "default": "1",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "aggregate_id",
        "aggregate_revision",
        "route"
      ],
      "title": "NavigateIntentV1",
      "type": "object"
    },
    "OpenCanvasIntentV1": {
