    "ToolErrorV1": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Code",
          "type": "string"
        },
        "message": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "retryable": {
          "default": false,
          "title": "Retryable",
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "ToolErrorV1",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "aggregate": {
      "anyOf": [
        {
          "$ref": "#/$defs/AggregateRefV1"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "correlation_id": {
      "format": "uuid",
      "title": "Correlation Id",
      "type": "string"
    },
    "error": {
      "anyOf": [
        {
          "$ref": "#/$defs/ToolErrorV1"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "evidence": {
      "anyOf": [
        {
          "$ref": "#/$defs/EvidenceRefV1"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "invocation_id": {
      "format": "uuid",
      "title": "Invocation Id",
      "type": "string"
    },
    "result": {
      "anyOf": [
        {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Result"
    },
    "state": {
      "enum": [
        "accepted",
        "rejected",
        "approval_required",
        "unavailable",
        "completed"
      ],
      "title": "State",
      "type": "string"
    },
    "ui_intent": {
      "anyOf": [
        {
          "discriminator": {
            "mapping": {
              "focus_answer": "#/$defs/FocusAnswerIntentV1",
              "navigate": "#/$defs/NavigateIntentV1",
              "open_canvas": "#/$defs/OpenCanvasIntentV1",
              "open_chapter": "#/$defs/OpenChapterIntentV1",
              "open_course": "#/$defs/OpenCourseIntentV1",
              "open_task": "#/$defs/OpenTaskIntentV1",
              "show_error": "#/$defs/ShowErrorIntentV1",
              "show_progress": "#/$defs/ShowProgressIntentV1",
              "show_result": "#/$defs/ShowResultIntentV1"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/NavigateIntentV1"
            },
            {
              "$ref": "#/$defs/OpenCourseIntentV1"
            },
            {
              "$ref": "#/$defs/OpenChapterIntentV1"
            },
            {
              "$ref": "#/$defs/OpenTaskIntentV1"
            },
            {
              "$ref": "#/$defs/FocusAnswerIntentV1"
            },
            {
              "$ref": "#/$defs/OpenCanvasIntentV1"
            },
            {
              "$ref": "#/$defs/ShowResultIntentV1"
            },
            {
              "$ref": "#/$defs/ShowProgressIntentV1"
            },
            {
              "$ref": "#/$defs/ShowErrorIntentV1"
            }
          ]
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Ui Intent"
    },
    "version": {
      "const": "1",
      "default": "1",
      "title": "Version",
      "type": "string"
    }
  },
  "required": [
    "invocation_id",
    "correlation_id",
    "state"
  ],
  "title": "ToolResultV1",
  "type": "object"
}
