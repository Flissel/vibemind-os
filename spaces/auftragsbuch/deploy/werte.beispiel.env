# Vorlage fuer laufzeit/werte.env (die echte Datei bleibt auf dem Mini-PC, ist git-ignoriert
# und enthaelt keine Geheimnisse: DSN, Schluessel und Schluessel-Hash liegen in eigenen Dateien).
# Eigene Datei, jede Zeile NAME=Wert ohne Anfuehrungszeichen. Beide Dienste (auftragsbuch und
# rowboat-abholer) lesen sie.

# Laden, in dem das Auftragsbuch schreibt (Wert aus dem Schema `auftrag`).
AUFTRAGSBUCH_LADEN=<LADEN>

# Laden, aus dem der Rowboat-Abholer Auftraege holt: derselbe Wert wie AUFTRAGSBUCH_LADEN (sonst
# startet der Abholer nicht).
ABHOLER_LADEN=<LADEN>

# Mandant, in dessen Namen Auftraege entstehen.
AUFTRAGSBUCH_MANDANT=<MANDANT>

# Weitere erlaubte Host-Kopfzeilen, kommagetrennt, klein geschrieben (`hostname` oder
# `hostname:port`). Hier steht der Name, unter dem der PC den Dienst ueber das private Netz
# aufruft; ohne ihn lehnt der Dienst solche Aufrufe ab.
AUFTRAGSBUCH_ZUSATZ_HOSTS=<HOSTNAME-IM-PRIVATEN-NETZ>

# Datenbank-Zugang fuer deploy/db_zugang.sh (keine Geheimnisse; das Passwort erzeugt das Skript
# selbst und legt es nur in der DSN-Datei ab). Benutzer fuer psql im Container ist supabase_admin.
# Name des Datenbank-Containers auf dem Mini-PC (`docker ps` zeigt ihn).
AUFTRAGSBUCH_DB_CONTAINER=<DB-CONTAINER>

# Host der Datenbank, so wie die Dienste sie erreichen. Beide laufen im Host-Netz: 127.0.0.1.
AUFTRAGSBUCH_DB_HOST=<DB-HOST>

# Port, an dem die Datenbank auf dem Mini-PC lauscht (`docker port <DB-CONTAINER>` zeigt ihn).
AUFTRAGSBUCH_DB_PORT=<DB-PORT>

# Name der Datenbank, in der das Schema `auftrag` liegt.
AUFTRAGSBUCH_DB_NAME=<DB-NAME>
