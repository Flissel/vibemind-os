{
  "gateway": {
    "mode": "local",
    "port": 19100,
    "bind": "loopback",
    "auth": {
      "mode": "token"
    },
    "http": {
      "endpoints": {
        "chatCompletions": {
          "enabled": true
        }
      }
    }
  },
  "models": {
    "providers": {
      "shim": {
        "baseUrl": "{{SHIM_URL}}",
        "api": "openai-completions",
        "apiKey": "shim-prueft-keinen-schluessel",
        "models": [
          {
            "id": "claude-code-sonnet",
            "name": "claude-code-sonnet"
          }
        ]
      }
    }
  },
  "agents": {
    "defaults": {
      "model": {
        "primary": "shim/claude-code-sonnet"
      },
      "workspace": "/home/node/.openclaw/workspace"
    },
    "list": [
      {
        "id": "main"
      },
      {
        "id": "brain-lesen",
        "workspace": "/home/node/.openclaw/workspace-brain",
        "tools": {
          "allow": [
            "event-app__list_tasks",
            "event-app__list_categories",
            "event-app__get_my_tasks",
            "event-app__list_members",
            "event-app__get_budget",
            "event-app__get_guest_stats",
            "event-app__list_recent_changes",
            "event-app__get_festival_info",
            "event-app__list_timetable"
          ]
        }
      },
      {
        "id": "brain-auftrag",
        "workspace": "/home/node/.openclaw/workspace-brain",
        "tools": {
          "allow": [
            "event-app__list_tasks",
            "event-app__list_categories",
            "event-app__get_my_tasks",
            "event-app__list_members",
            "event-app__get_budget",
            "event-app__get_guest_stats",
            "event-app__list_recent_changes",
            "event-app__get_festival_info",
            "event-app__list_timetable",
            "event-app__create_task",
            "event-app__update_task",
            "event-app__delete_task",
            "event-app__import_orga_plan",
            "event-app__create_team",
            "event-app__create_member",
            "event-app__update_member",
            "event-app__send_message_to_member",
            "event-app__create_timetable_slot",
            "event-app__update_timetable_slot",
            "event-app__delete_timetable_slot"
          ]
        }
      }
    ]
  },
  "plugins": {
    "entries": {
      "telegram": {
        "enabled": true
      },
      "whatsapp": {
        "enabled": true
      },
      "browser": {
        "enabled": false
      }
    }
  },
  "browser": {
    "enabled": false,
    "defaultProfile": "openclaw"
  },
  "channels": {
    "telegram": {
      "enabled": true,
      "groupPolicy": "allowlist",
      "groups": {
        "{{TELEGRAM_GRUPPE}}": {
          "requireMention": false
        }
      }
    },
    "whatsapp": {
      "enabled": true,
      "dmPolicy": "allowlist",
      "allowFrom": ["{{WHATSAPP_ERLAUBT}}"],
      "groupPolicy": "disabled"
    }
  },
  "mcp": {
    "servers": {
      "event-app": {
        "url": "{{EVENT_APP_URL}}/api/mcp",
        "transport": "streamable-http",
        "connectionTimeoutMs": 30000,
        "requestTimeoutMs": 60000
      }
    }
  },
  "tools": {
    "deny": ["group:web", "group:ui", "group:automation"],
    "web": {
      "search": {
        "enabled": false
      },
      "fetch": {
        "enabled": false
      }
    }
  }
}
