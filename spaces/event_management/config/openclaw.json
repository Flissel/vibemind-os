{
  "gateway": {
    "mode": "local",
    "port": 19100,
    "bind": "loopback",
    "auth": {
      "mode": "token"
    },
    "http": {
      "endpoints": {
        "chatCompletions": {
          "enabled": true
        }
      }
    }
  },
  "models": {
    "providers": {
      "shim": {
        "baseUrl": "{{SHIM_URL}}",
        "api": "openai-completions",
        "apiKey": "shim-prueft-keinen-schluessel",
        "models": [
          {
            "id": "claude-code-sonnet",
            "name": "claude-code-sonnet"
          }
        ]
      }
    }
  },
  "session": {
    "dmScope": "per-channel-peer"
  },
  "agents": {
    "defaults": {
      "model": {
        "primary": "shim/claude-code-sonnet"
      },
      "workspace": "/home/node/.openclaw/workspace"
    },
    "list": [
      {
        "id": "main",
        "tools": {
          "allow": ["melden__gruppe_melden", "melden__chat_melden"]
        }
      },
      {
        "id": "ev-legacy",
        "workspace": "/home/node/.openclaw/workspace-legacy",
        "tools": {
          "allow": ["event-app__*"]
        }
      },
      {
        "id": "brain-lesen",
        "workspace": "/home/node/.openclaw/workspace-brain",
        "tools": {
          "allow": [
            "event-app__list_tasks",
            "event-app__list_categories",
            "event-app__get_my_tasks",
            "event-app__list_members",
            "event-app__get_budget",
            "event-app__get_guest_stats",
            "event-app__list_recent_changes",
            "event-app__get_festival_info",
            "event-app__list_timetable",
            "bn-lesen__*"
          ]
        }
      },
      {
        "id": "brain-auftrag",
        "workspace": "/home/node/.openclaw/workspace-brain",
        "tools": {
          "allow": [
            "event-app__list_tasks",
            "event-app__list_categories",
            "event-app__get_my_tasks",
            "event-app__list_members",
            "event-app__get_budget",
            "event-app__get_guest_stats",
            "event-app__list_recent_changes",
            "event-app__get_festival_info",
            "event-app__list_timetable",
            "event-app__create_task",
            "event-app__update_task",
            "event-app__delete_task",
            "event-app__import_orga_plan",
            "event-app__create_team",
            "event-app__create_member",
            "event-app__update_member",
            "event-app__send_message_to_member",
            "event-app__create_timetable_slot",
            "event-app__update_timetable_slot",
            "event-app__delete_timetable_slot",
            "bn-auftrag__events_suchen",
            "bn-auftrag__event_waehlen",
            "bn-auftrag__event_info",
            "bn-auftrag__verlauf_lesen",
            "bn-auftrag__kontakte_suchen",
            "bn-auftrag__nachrichten_liste",
            "bn-auftrag__kontakt_anlegen",
            "bn-auftrag__mail_entwerfen",
            "bn-auftrag__event_absagen",
            "bn-auftrag__event_archivieren",
            "bn-auftrag__kontakt_entfernen",
            "bn-auftrag__rolle_aendern",
            "bn-auftrag__gruppe_verbinden",
            "bn-auftrag__aenderungen_seit",
            "bn-auftrag__aufgaben_liste",
            "bn-auftrag__aufgaben_anlegen",
            "bn-auftrag__aufgaben_aendern",
            "bn-auftrag__aufgaben_kategorien_liste",
            "bn-auftrag__aufgaben_kategorien_anlegen",
            "bn-auftrag__aufgaben_kategorien_aendern",
            "bn-auftrag__orga_team_liste",
            "bn-auftrag__orga_team_anlegen",
            "bn-auftrag__orga_team_aendern",
            "bn-auftrag__teilnehmende_liste",
            "bn-auftrag__teilnehmende_anlegen",
            "bn-auftrag__teilnehmende_aendern",
            "bn-auftrag__ablauf_liste",
            "bn-auftrag__ablauf_anlegen",
            "bn-auftrag__ablauf_aendern",
            "bn-auftrag__budget_liste",
            "bn-auftrag__budget_anlegen",
            "bn-auftrag__budget_aendern",
            "bn-auftrag__wettbewerb_teams_liste",
            "bn-auftrag__wettbewerb_teams_anlegen",
            "bn-auftrag__wettbewerb_teams_aendern",
            "bn-auftrag__abgaben_liste",
            "bn-auftrag__abgaben_anlegen",
            "bn-auftrag__abgaben_aendern",
            "bn-auftrag__jury_liste",
            "bn-auftrag__jury_anlegen",
            "bn-auftrag__jury_aendern",
            "bn-auftrag__aussteller_liste",
            "bn-auftrag__aussteller_anlegen",
            "bn-auftrag__aussteller_aendern",
            "bn-auftrag__staende_liste",
            "bn-auftrag__staende_anlegen",
            "bn-auftrag__staende_aendern",
            "bn-auftrag__sprecher_liste",
            "bn-auftrag__sprecher_anlegen",
            "bn-auftrag__sprecher_aendern",
            "bn-auftrag__online_raum_liste",
            "bn-auftrag__online_raum_anlegen",
            "bn-auftrag__online_raum_aendern",
            "bn-auftrag__aufzeichnung_liste",
            "bn-auftrag__aufzeichnung_anlegen",
            "bn-auftrag__aufzeichnung_aendern",
            "bn-auftrag__protokoll_liste",
            "bn-auftrag__protokoll_anlegen",
            "bn-auftrag__protokoll_aendern",
            "bn-auftrag__beschluesse_liste",
            "bn-auftrag__beschluesse_anlegen",
            "bn-auftrag__beschluesse_aendern",
            "bn-auftrag__verpflegung_liste",
            "bn-auftrag__verpflegung_anlegen",
            "bn-auftrag__verpflegung_aendern",
            "bn-auftrag__programm_liste",
            "bn-auftrag__programm_anlegen",
            "bn-auftrag__programm_aendern",
            "bn-auftrag__helferschichten_liste",
            "bn-auftrag__helferschichten_anlegen",
            "bn-auftrag__helferschichten_aendern",
            "bn-auftrag__buehnen_liste",
            "bn-auftrag__buehnen_anlegen",
            "bn-auftrag__buehnen_aendern"
          ]
        }
      }
    ]
  },
  "bindings": [
    {
      "agentId": "ev-legacy",
      "match": {
        "channel": "telegram",
        "peer": {
          "kind": "group",
          "id": "{{TELEGRAM_GRUPPE}}"
        }
      }
    }
  ],
  "plugins": {
    "entries": {
      "telegram": {
        "enabled": true
      },
      "whatsapp": {
        "enabled": false
      },
      "browser": {
        "enabled": false
      }
    }
  },
  "browser": {
    "enabled": false,
    "defaultProfile": "openclaw"
  },
  "channels": {
    "telegram": {
      "enabled": true,
      "groupPolicy": "allowlist",
      "groups": {
        "{{TELEGRAM_GRUPPE}}": {
          "requireMention": false
        },
        "*": {
          "requireMention": true
        }
      }
    },
    "whatsapp": {
      "enabled": false,
      "dmPolicy": "allowlist",
      "allowFrom": ["{{WHATSAPP_ERLAUBT}}"],
      "groupPolicy": "disabled"
    }
  },
  "mcp": {
    "servers": {
      "event-app": {
        "url": "{{EVENT_APP_URL}}/api/mcp",
        "transport": "streamable-http",
        "connectionTimeoutMs": 30000,
        "requestTimeoutMs": 60000
      },
      "melden": {
        "url": "{{EVENT_MCP_URL}}/mcp",
        "transport": "streamable-http",
        "connectionTimeoutMs": 30000,
        "requestTimeoutMs": 60000
      },
      "bn-lesen": {
        "url": "{{EVENT_MCP_URL}}/mcp",
        "transport": "streamable-http",
        "connectionTimeoutMs": 30000,
        "requestTimeoutMs": 60000
      },
      "bn-auftrag": {
        "url": "{{EVENT_MCP_URL}}/mcp",
        "transport": "streamable-http",
        "connectionTimeoutMs": 30000,
        "requestTimeoutMs": 60000
      }
    }
  },
  "tools": {
    "deny": ["group:web", "group:ui", "group:automation"],
    "web": {
      "search": {
        "enabled": false
      },
      "fetch": {
        "enabled": false
      }
    }
  }
}
